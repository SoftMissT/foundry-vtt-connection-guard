{
  "name": "connection-guard",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "description": "Latência, diagnóstico de conexão, reconexão automática, assistente de STUN/TURN e Route Oracle Abyss Link para Foundry VTT.",
  "author": "Kazuto",
  "license": "GPL-3.0",
  "scripts": {
    "lint": "eslint scripts --ext .js",
    "lint:fix": "eslint scripts --ext .js --fix",
    "format": "prettier --write \"scripts/**/*.js\" \"lang/**/*.json\" \"*.md\"",
    "package": "node scripts-dev/package-zip.mjs",
    "release": "npm run lint && npm run package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@league-of-foundry-developers/foundry-vtt-types": "13.346.0-beta.20251209192131",
    "bestzip": "^3.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.9.0"
  }
}
